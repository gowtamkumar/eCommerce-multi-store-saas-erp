{
    # Enable Caddy's internal authority to issue local self-signed certificates
    local_certs

    # Set up On-Demand TLS checks pointing to our server container in the Docker network
    on_demand_tls {
        ask      "http://server:3900/api/v1/stores/check-domain"
        interval 2m
        burst    5
    }
}

# Route localhost and any subdomains (e.g. gowtam.localhost)
http://localhost, https://localhost, http://*.localhost, https://*.localhost {
    reverse_proxy client:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Catch-all HTTPS block for testing simulated custom domains (e.g. shop.localtest.me)
# We match port 443 and automatically request local certificates on demand.
:443 {
    tls {
        on_demand
    }

    reverse_proxy client:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
