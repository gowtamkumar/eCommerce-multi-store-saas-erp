NODE_ENV=development

# API
API_PORT=3900
API_URL=http://localhost:3900/api/v1
HOST=localhost
# Public storefront/admin URL used as a safe billing redirect fallback.
FRONTEND_URL=http://localhost:3000
# Production CORS allowlist (comma-separated absolute origins). Subdomains of
# PLATFORM_HOST are always allowed. Add tenant custom domains here.
# CORS_ORIGINS=https://app.gowtam.com,https://admin.gowtam.com
# Root platform host used to allow tenant subdomain billing redirects, e.g. acme.gowtam.com.
# Do not include protocol or a subdomain.
PLATFORM_HOST=gowtam.com
# File properties
UPLOAD_PATH=public/uploads
# Max 5Mb allowed
MAX_FILE_SIZE=5
MAX_FILE_COUNTS=20

# REQUIRED: generate a strong random secret, e.g. `openssl rand -hex 48`.
# The server refuses to start/authenticate if this is unset.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=15m #15 minutes
JWT_REFRESH_TOKEN_EXPIRES=7d

# REQUIRED to enable the one-time super-admin bootstrap endpoint (/super-admin/setup).
# Leave unset in normal operation to keep the endpoint disabled.
SuperAdmin_SETUP_KEY=

# Database environment variables
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=multi_tenant_ecommerce
# Schema management. Leave unset to auto-sync in dev and stay OFF in production.
# NEVER set DB_SYNCHRONIZE=true in production. Use migrations instead.
# DB_SYNCHRONIZE=false
# Apply pending migrations on boot (recommended in production).
# DB_MIGRATIONS_RUN=true

# MinIO variables for your server
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=erp-media
MINIO_REGION=us-east-1


# Redis environment variables
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=300 # Cache time-to-live in seconds (5 minutes)

## Pathao credentials
PATHAO_SENDBOX_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_BASE_URL=https://api-hermes.pathao.com
