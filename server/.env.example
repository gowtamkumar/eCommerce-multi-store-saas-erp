NODE_ENV=development

# API
API_PORT=3900
API_URL=http://localhost:3900/api/v1
HOST=localhost
# File properties
UPLOAD_PATH=public/uploads
# Max 5Mb allowed
MAX_FILE_SIZE=5
MAX_FILE_COUNTS=20

JWT_SECRET_KEY=myUnsecureJwtSecret
JWT_ACCESS_TOKEN_EXPIRES=15m #15 minutes
JWT_REFRESH_TOKEN_EXPIRES=7d

# Database environment variables
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=multi_tenant_ecommerce

# Redis environment variables
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=300
MAX_CACHE_ITEMS=1000

